# ----------------------------------------------------------------------------
# Agentic Procurement OS — environment
#
# Copy to `.env`. A working `.env` ships with the project, so
# `docker compose up -d --wait` works with no edits at all.
# ----------------------------------------------------------------------------

# Host ports.
APP_PORT=8080
MAIL_UI_PORT=8025
DB_PORT=5433

# --------------------------------------------------------------- postgres
# Self-hosted Postgres from docker-compose. Unset this and the app falls back
# to the JSON file store.
DATABASE_URL=postgres://procurement:procurement@db:5432/procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement
POSTGRES_DB=procurement

# ----------------------------------------------------------------- mail
# Outbound RFQ channel. Defaults to the Mailpit service in docker-compose,
# which is a real SMTP server: messages are genuinely transmitted and land in
# a real inbox at http://localhost:8025 — they just do not leave the machine.
#
# Point this at a real relay to deliver externally. Same code path.
#   DEMO_SMTP_URL=smtps://user:pass@smtp.yourhost.com:465
DEMO_SMTP_URL=smtp://mail:1025
DEMO_INBOX_URL=http://localhost:8025
DEMO_FROM_ADDRESS=procurement@nestle-demo.local

# How long a fictional directory supplier waits before replying with a
# quotation. Real graph8-discovered companies never auto-reply.
DEMO_REPLY_DELAY_SECONDS=6

# --------------------------------------------------------------- graph8
# With a key, free-text intake is parsed by the LLM skill hosted in your graph8
# org. Without one, a built-in deterministic parser is used instead.
GRAPH8_API_KEY=
GRAPH8_API_BASE=https://be.graph8.com/api/v1
GRAPH8_INTAKE_SKILL_ID=2730f9a5-a7ee-4159-9396-986bd1be7cfa

# Set false to silence per-request logging.
LOG_REQUESTS=true
